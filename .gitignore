.venv/

# Editor and OS files
.vscode/
.DS_Store

# AI assistant config files
.claude/
CLAUDE.md

# Python cache/build artifacts
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# LaTeX build artifacts
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
texput.log

# Experiment outputs and logs
runs/
slurm_jobs/

# Artifacts — ignore bulk experiment data, but track model configs (JSON only)
artifacts/*
!artifacts/models/
artifacts/models/*
!artifacts/models/mlp/
!artifacts/models/random/
!artifacts/models/baseline/

# Model binaries are distributed via DaRUS (DOI: 10.18419/DARUS-5815), not git.
# Only JSON configs and manifests are tracked for documentation.
artifacts/models/**/*.pt
artifacts/models/**/*.pkl
artifacts/models/**/*.npz

# TensorBoard/event logs (inside tracked artifact dirs too)
events.out.tfevents.*

# Thesis description (local only)
Ausschreibung.pdf

#plots just save the summary .md files
*.png
*.pdf

# Keep thesis plot exports under docs/plots versioned.
!docs/plots/**/*.png
!docs/plots/**/*.pdf