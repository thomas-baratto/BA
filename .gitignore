.venv/

# Editor and OS files
.vscode/
.DS_Store

# AI assistant config files
.claude/
CLAUDE.md

# Python cache/build artifacts
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# LaTeX build artifacts
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
texput.log

# Experiment outputs - only track seed_sweep multi_seed_summary.json files
runs/**
!runs/**/
!runs/seed_sweep_*/*/multi_seed_summary.json
slurm_jobs/

# Artifacts — ignore bulk experiment data, but track pre-trained models
artifacts/*
!artifacts/models/
artifacts/models/*
!artifacts/models/mlp/
!artifacts/models/random/
!artifacts/models/baseline/
!artifacts/models/benchmark_inference_results.json
!artifacts/packages/

# Random model binaries are too large for git (>200 MB).
# They are deterministically reproducible via:
#   PYTHONPATH=. python scripts/deployment/retrain_random_models.py
artifacts/models/random/**/model.pkl

# TensorBoard/event logs (inside tracked artifact dirs too)
events.out.tfevents.*

# Thesis description (local only)
Ausschreibung.pdf

# DaRUS upload zips (build output from scripts/package_darus.sh)
darus_upload/**/*.zip
darus_upload/*.zip

#plots just save the summary .md files
*.png
*.pdf

# Keep thesis plot exports under docs/plots versioned.
!docs/plots/**/*.png
!docs/plots/**/*.pdf